local function createToggle(texto, posY, isOn, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 35)
    frame.Position = UDim2.new(0, 10, 0, posY)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    frame.BorderSizePixel = 0
    frame.Parent = contentFrame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Text = texto
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 70, 0, 25)
    btn.Position = UDim2.new(1, -80, 0.5, -12)
    btn.Text = isOn and "LIGADO" or "DESLIGADO"
    btn.BackgroundColor3 = isOn and Color3.fromRGB(0, 130, 0) or Color3.fromRGB(130, 0, 0)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.Parent = frame
    
    btn.MouseButton1Click:Connect(function()
        local newState = not isOn
        callback(newState)
        isOn = newState
        btn.Text = isOn and "LIGADO" or "DESLIGADO"
        btn.BackgroundColor3 = isOn and Color3.fromRGB(0, 130, 0) or Color3.fromRGB(130, 0, 0)
    end)
end

local function createSlider(texto, posY, minVal, maxVal, currentVal, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -20, 0, 55)
    frame.Position = UDim2.new(0, 10, 0, posY)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    frame.BorderSizePixel = 0
    frame.Parent = contentFrame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.8, 0, 0.4, 0)
    label.Position = UDim2.new(0, 10, 0, 5)
    label.Text = texto .. ": " .. currentVal
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.Parent = frame
    
    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 30, 0, 25)
    minus.Position = UDim2.new(0.7, 0, 0.5, -2)
    minus.Text = "-"
    minus.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    minus.TextColor3 = Color3.fromRGB(255, 255, 255)
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 14
    minus.BorderSizePixel = 0
    minus.Parent = frame
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 40, 0, 25)
    valueLabel.Position = UDim2.new(0.78, 0, 0.5, -2)
    valueLabel.Text = tostring(currentVal)
    valueLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    valueLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 12
    valueLabel.Parent = frame
    
    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 30, 0, 25)
    plus.Position = UDim2.new(0.86, 0, 0.5, -2)
    plus.Text = "+"
    plus.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    plus.TextColor3 = Color3.fromRGB(255, 255, 255)
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 14
    plus.BorderSizePixel = 0
    plus.Parent = frame
    
    minus.MouseButton1Click:Connect(function()
        local newVal = math.max(minVal, currentVal - 1)
        if newVal ~= currentVal then
            currentVal = newVal
            valueLabel.Text = tostring(currentVal)
            label.Text = texto .. ": " .. currentVal
            callback(currentVal)
        end
    end)
    
    plus.MouseButton1Click:Connect(function()
        local newVal = math.min(maxVal, currentVal + 1)
        if newVal ~= currentVal then
            currentVal = newVal
            valueLabel.Text = tostring(currentVal)
            label.Text = texto .. ": " .. currentVal
            callback(currentVal)
        end
    end)
end

