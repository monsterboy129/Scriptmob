-- ========== ABRIR/FECHAR COM TECLA F5 ==========
UserInput.InputBegan:Connect(function(input, isProcessed)
    if not isProcessed and input.KeyCode == Enum.KeyCode.F5 then
        mainFrame.Visible = not mainFrame.Visible
        if mainFrame.Visible then
            updateContent()
        end
    end
end)

-- ========== LOOP PRINCIPAL DO JOGO ==========
local lastAction = 0

spawn(function()
    while true do
        local delay = slowMode and 0.4 or 0.1
        wait(delay)
        
        pcall(function()
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local ball = workspace:FindFirstChild("Ball")
            
            -- Anti-Ban delay
            if antiBan and tick() - lastAction < 0.3 then
                wait(math.random(1, 2) / 10)
            end
            
            -- Auto Spike
            if autoSpike and ball then
                local dist = (ball.Position - hrp.Position).Magnitude
                if dist < 18 then
                    local spike = game:GetService("ReplicatedStorage"):FindFirstChild("Spike")
                    if spike then
                        spike:FireServer(ball)
                        lastAction = tick()
                    end
                end
            end
            
            -- Auto Receive
            if autoReceive and ball then
                local dist = (ball.Position - hrp.Position).Magnitude
                if dist < 10 then
                    local receive = game:GetService("ReplicatedStorage"):FindFirstChild("Receive")
                    if receive then
                        receive:FireServer(ball)
                        lastAction = tick()
                    end
                end
            end
            
            -- Auto Jump
            if autoJump then
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
                    humanoid.Jump = true
                    lastAction = tick()
                end
            end
            
            -- Auto Power
            if autoPower then
                local power = game:GetService("ReplicatedStorage"):FindFirstChild("ActivatePower")
                if power then
                    power:FireServer()
                end
            end
            
            -- Hitbox
            if hitboxEnabled then
                hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            elseif hrp.Size ~= Vector3.new(2, 2, 1) then
                hrp.Size = Vector3.new(2, 2, 1)
            end
        end)
    end
end)

